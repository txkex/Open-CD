{
  "name": "open-cd",
  "productName": "Open CD",
  "version": "0.4.0",
  "description": "A 3D shelf of CD cases for your local and Jellyfin music library",
  "author": "txkex",
  "license": "MIT",
  "homepage": "https://github.com/txkex/Open-CD",
  "repository": { "type": "git", "url": "git+https://github.com/txkex/Open-CD.git" },
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never",
    "dist:win": "electron-builder --win portable nsis --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "jsmediatags": "^3.9.7"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "three": "0.128.0"
  },
  "build": {
    "appId": "local.opencd",
    "copyright": "Copyright (c) 2026 txkex",
    "directories": { "output": "dist" },
    "files": ["index.html", "main.js", "preload.js", "scanner.js", "build/icon.png", "vendor/**/*"],
    "win": { "target": "portable" },
    "portable": { "artifactName": "OpenCD-${version}-portable.${ext}" },
    "nsis": { "artifactName": "OpenCD-${version}-setup.${ext}" },
    "linux": { "target": "AppImage", "category": "Audio" },
    "appImage": { "artifactName": "OpenCD-${version}-x86_64.${ext}" }
  }
}
